# ─────────────────────────────────────────────────────────────
#  Vigil · Protection System — environment
#  Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram user ID of the system owner (full control, authorizes channels)
SYSTEM_OWNER_ID=

# OpenRouter API key (English content moderation). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Fallback chain — all free models, smartest first. Comma separated.
# Refresh the live list with:  python scripts/free_models.py
MODERATION_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,qwen/qwen3.8-27b:free,nvidia/nemotron-3-super-120b-a12b:free,google/gemma-4-31b-it:free,nvidia/nemotron-3.5-lightning:free,inclusionai/ling-3.0-flash-fin:free,openrouter/free

# Per-request timeout for the moderation API (seconds)
MODERATION_TIMEOUT_SECONDS=12

# What to do when every model fails: open (allow, alert) | closed (treat as violation)
MODERATION_FAIL_MODE=open

# Daily request budget. OpenRouter free tier: 50/day per ACCOUNT (1000/day once you have
# bought $10 of credits, once). Keep a margin below the real limit.
MODERATION_DAILY_BUDGET=45

# Reasoning effort hint for reasoning-capable models: low | medium | high | off
MODERATION_REASONING_EFFORT=low

# Database. SQLite by default; PostgreSQL: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./data/vigil.db

# Defaults for new channels / users
DEFAULT_TIMEZONE=Asia/Baghdad
DEFAULT_LANGUAGE=en

# Post a short "not activated" notice inside unauthorized channels (needs Post messages right)
UNAUTHORIZED_NOTICE_IN_CHANNEL=true

# Optional webhook mode (leave WEBHOOK_URL empty for long polling)
WEBHOOK_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=
WEB_HOST=0.0.0.0
WEB_PORT=8080

LOG_LEVEL=INFO
